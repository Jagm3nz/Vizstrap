<v:NeonWindow x:Class="Vizstrap.Views.FlagDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              Width="520"
              SizeToContent="Height"
              ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <StackPanel>
            <ui:TitleBar x:Name="TitleBar" ShowMaximize="False" ShowMinimize="False" CanMaximize="False" />

            <StackPanel Margin="24,4,24,18">
                <!-- add one flag -->
                <StackPanel x:Name="AddPanel">
                    <TextBlock Text="{x:Static l:Strings.Flags_Name}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <ComboBox x:Name="NameBox" IsEditable="True" IsTextSearchEnabled="False" SelectionChanged="OnNameChosen" />
                    <TextBlock Text="{x:Static l:Strings.Flags_AddHint}" Style="{StaticResource CardDescription}" Margin="0,4,0,14" />

                    <TextBlock Text="{x:Static l:Strings.Flags_Value}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                    <ui:TextBox x:Name="ValueBox" />
                </StackPanel>

                <!-- import many -->
                <StackPanel x:Name="ImportPanel" Visibility="Collapsed">
                    <TextBlock Text="{x:Static l:Strings.Flags_ImportHint}" Style="{StaticResource CardDescription}" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="JsonBox" AcceptsReturn="True" TextWrapping="NoWrap" Height="220"
                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                </StackPanel>

                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#E5484D" Visibility="Collapsed" />
            </StackPanel>

            <Border Background="{DynamicResource NeonSurfaceBrush}" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static l:Strings.Common_Cancel}" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                    <ui:Button x:Name="ConfirmButton" MinWidth="96" Appearance="Primary" IsDefault="True" Click="OnConfirm" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</v:NeonWindow>
