<v:NeonWindow x:Class="Vizstrap.Views.MenuWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              Width="580"
              SizeToContent="Height"
              ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="Vizstrap" Padding="8" ShowMinimize="False" ShowMaximize="False" CanMaximize="False"
                         KeyboardNavigation.TabNavigation="None">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- left: brand -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                        <Image Source="{StaticResource VizstrapLogo}" Width="64" Height="64" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Vizstrap" FontSize="24" Foreground="{DynamicResource NeonTextBrush}" />
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ui:HyperlinkButton Content="{x:Static l:Strings.Settings_About}" Icon="{ui:SymbolIcon QuestionCircle24}"
                                        HorizontalAlignment="Center" Click="OnAbout" />
                </StackPanel>

                <!-- right: actions -->
                <StackPanel Grid.Column="1" Margin="0,16,16,16">
                    <ui:CardAction x:Name="LaunchCard" Icon="{ui:SymbolIcon ArrowRight24}" Click="OnLaunch" TabIndex="0">
                        <TextBlock Text="{x:Static l:Strings.Menu_LaunchRoblox}" FontSize="14" />
                    </ui:CardAction>

                    <ui:CardAction Icon="{ui:SymbolIcon Settings24}" Click="OnSettings" Margin="0,8,0,0" TabIndex="1">
                        <TextBlock Text="{x:Static l:Strings.Menu_ConfigureSettings}" FontSize="14" />
                    </ui:CardAction>

                    <ui:CardAction Icon="{ui:SymbolIcon BookQuestionMark24}" Click="OnHelp" Margin="0,40,0,0" TabIndex="2">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Menu_Help}" FontSize="14" />
                            <TextBlock Text="{x:Static l:Strings.Menu_HelpDescription}" Margin="0,2,0,0" FontSize="12"
                                       TextWrapping="Wrap" Padding="0,0,16,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ui:CardAction>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</v:NeonWindow>
