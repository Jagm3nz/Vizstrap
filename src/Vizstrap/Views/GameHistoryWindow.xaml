<v:NeonWindow x:Class="Vizstrap.Views.GameHistoryWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:GameHistoryViewModel}"
              Title="{x:Static l:Strings.Tray_GameHistory}"
              Width="600"
              Height="480"
              MinWidth="440"
              MinHeight="320">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="{x:Static l:Strings.Tray_GameHistory}" ShowMinimize="False" ShowMaximize="False" CanMaximize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <TextBlock Grid.Row="1" Text="{x:Static l:Strings.History_Description}" Style="{StaticResource CardDescription}"
                       TextWrapping="Wrap" Margin="20,4,20,12" />

            <ui:ProgressRing Grid.Row="2" IsIndeterminate="True" VerticalAlignment="Center" HorizontalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />

            <TextBlock Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" Margin="20,0"
                       Foreground="{DynamicResource NeonTextSecondaryBrush}"
                       Visibility="{Binding Error, Converter={StaticResource NotNullToVisible}}" />

            <TextBlock Grid.Row="2" Text="{x:Static l:Strings.History_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource NeonTextMutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisible}}">
                <ItemsControl ItemsSource="{Binding Entries}" Margin="16,0,16,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameHistoryEntry}">
                            <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="96" Height="96" CornerRadius="7,0,0,7" Background="{DynamicResource NeonTrackBrush}">
                                        <Border CornerRadius="7,0,0,7">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding IconUrl, IsAsync=True, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,10,12,10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource NeonTextBrush}" />
                                        <TextBlock Text="{Binding Description}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                                        <ui:Button Content="{x:Static l:Strings.History_Rejoin}" Icon="{ui:SymbolIcon Play24}"
                                                   Appearance="Primary" Margin="0,8,0,0"
                                                   Command="{Binding DataContext.RejoinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</v:NeonWindow>
