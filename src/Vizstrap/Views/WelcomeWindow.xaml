<v:NeonWindow x:Class="Vizstrap.Views.WelcomeWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:WelcomeViewModel}"
              Title="Vizstrap"
              Width="620"
              Height="560"
              ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="Vizstrap" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <StackPanel Grid.Row="1" Margin="28,4,28,12">
                <TextBlock Text="{Binding StepText}" Style="{StaticResource CardDescription}" />
                <ProgressBar Style="{StaticResource NeonProgressBar}" Height="4" Margin="0,6,0,0" Value="{Binding StepProgress, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,0,28,12">
                <Grid>
                    <!-- 1: look -->
                    <StackPanel Visibility="{Binding IsFirstStep, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="{x:Static l:Strings.Welcome_Title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{x:Static l:Strings.Welcome_Subtitle}" Style="{StaticResource PageDescription}" Margin="0,4,0,16" />

                        <ui:CardControl Style="{StaticResource SettingsCard}">
                            <ui:CardControl.Header>
                                <TextBlock Text="{x:Static l:Strings.Settings_Theme}" Style="{StaticResource CardTitle}" />
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name" Width="200" />
                        </ui:CardControl>

                        <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedAccent.Name}" Foreground="{DynamicResource NeonAccentBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Static l:Strings.Settings_Accent}" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" Margin="-4,8,0,0"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <!-- a ring around the picked colour instead of the list's highlight -->
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Ring" Width="40" Height="40" CornerRadius="20" Margin="0,0,6,0"
                                                                BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource NeonBorderBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource NeonTextBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AccentOption}">
                                            <Ellipse Width="30" Height="30" Fill="{Binding Swatch}" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <ui:CardControl Style="{StaticResource SettingsCard}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Settings_Style}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Welcome_StyleDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" DisplayMemberPath="Name" Width="200" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- 2: Discord -->
                    <StackPanel Visibility="{Binding IsDiscordStep, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Discord" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{x:Static l:Strings.Welcome_DiscordDescription}" Style="{StaticResource PageDescription}" Margin="0,4,0,16" />

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Games24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Integrations_ShowActivity}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Integrations_ShowActivityDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding UseDiscordRichPresence}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Sparkle24}" IsEnabled="{Binding UseDiscordRichPresence}">
                            <ui:CardControl.Header>
                                <TextBlock Text="{x:Static l:Strings.Integrations_Watermark}" Style="{StaticResource CardTitle}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowVizstrapWatermark}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Home24}" IsEnabled="{Binding UseDiscordRichPresence}">
                            <ui:CardControl.Header>
                                <TextBlock Text="{x:Static l:Strings.Integrations_InMenu}" Style="{StaticResource CardTitle}" />
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding ShowPresenceInMenu}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PeopleAdd24}" IsEnabled="{Binding UseDiscordRichPresence}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Integrations_AllowJoining}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Integrations_AllowJoiningDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding AllowActivityJoining}" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- 3: Roblox -->
                    <StackPanel Visibility="{Binding IsRobloxStep, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Roblox" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{x:Static l:Strings.Welcome_RobloxDescription}" Style="{StaticResource PageDescription}" Margin="0,4,0,16" />

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PaintBucket24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Settings_RobloxTheme}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Welcome_RobloxThemeDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding RobloxAccentTheme}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon ArrowDownload24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Settings_BackgroundUpdates}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Welcome_BackgroundUpdatesDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding BackgroundUpdates}" />
                        </ui:CardControl>

                        <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Gauge24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Static l:Strings.Welcome_Graphics}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{x:Static l:Strings.Welcome_GraphicsDescription}" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Width="160" />
                        </ui:CardControl>
                    </StackPanel>

                    <!-- 4: done -->
                    <StackPanel Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisible}}" VerticalAlignment="Center" Margin="0,40,0,0">
                        <ui:SymbolIcon Symbol="CheckmarkCircle48" FontSize="64" Foreground="{DynamicResource NeonAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static l:Strings.Welcome_DoneTitle}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="{x:Static l:Strings.Welcome_DoneDescription}" Style="{StaticResource PageDescription}"
                                   TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="3" Background="{DynamicResource NeonSurfaceBrush}" Padding="24,14">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Left" Content="{x:Static l:Strings.Welcome_Back}" Icon="{ui:SymbolIcon ArrowLeft24}"
                               Command="{Binding BackCommand}" MinWidth="96"
                               Visibility="{Binding IsFirstStep, Converter={StaticResource InverseBoolToVisible}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{x:Static l:Strings.Welcome_Next}" Command="{Binding NextCommand}" Appearance="Primary" MinWidth="110"
                                   Visibility="{Binding IsLastStep, Converter={StaticResource InverseBoolToVisible}}" />
                        <ui:Button Content="{x:Static l:Strings.Welcome_Finish}" Command="{Binding FinishCommand}" MinWidth="110"
                                   Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisible}}" />
                        <ui:Button Content="{x:Static l:Strings.Installer_LaunchRoblox}" Command="{Binding LaunchRobloxCommand}" Appearance="Primary"
                                   Icon="{ui:SymbolIcon Play24}" MinWidth="140" Margin="8,0,0,0"
                                   Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</v:NeonWindow>
