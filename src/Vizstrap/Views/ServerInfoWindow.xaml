<v:NeonWindow x:Class="Vizstrap.Views.ServerInfoWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              Title="{x:Static l:Strings.Tray_ServerInfo}"
              Width="440"
              SizeToContent="Height"
              ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <StackPanel>
            <ui:TitleBar Title="{x:Static l:Strings.Tray_ServerInfo}" ShowMaximize="False" ShowMinimize="False" CanMaximize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Grid Margin="24,8,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static l:Strings.Server_Type}" Foreground="{DynamicResource NeonTextBrush}" Margin="0,0,20,12" />
                <TextBlock x:Name="TypeText" Grid.Column="1" Foreground="{DynamicResource NeonTextSecondaryBrush}" Margin="0,0,0,12" />

                <TextBlock Grid.Row="1" Text="{x:Static l:Strings.Server_InstanceId}" Foreground="{DynamicResource NeonTextBrush}" Margin="0,0,20,12" />
                <TextBlock x:Name="InstanceText" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource NeonTextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,12" />

                <TextBlock x:Name="LocationLabel" Grid.Row="2" Text="{x:Static l:Strings.Server_Location}" Foreground="{DynamicResource NeonTextBrush}" Margin="0,0,20,0" />
                <TextBlock x:Name="LocationText" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource NeonTextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <Border Background="{DynamicResource NeonSurfaceBrush}" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static l:Strings.Server_CopyInstanceId}" Icon="{ui:SymbolIcon Copy24}" Click="OnCopy" />
                    <ui:Button Content="{x:Static l:Strings.Common_Close}" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</v:NeonWindow>
