<UserControl x:Class="Vizstrap.Views.Widgets.PlaytimeGamesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Vizstrap.Localization"
             xmlns:vm="clr-namespace:Vizstrap.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlaytimeViewModel}">
    <!-- activity widget: the period's games, most played first, with Play -->
<StackPanel>
    <TextBlock Text="{x:Static l:Strings.Playtime_Games}" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />

    <TextBlock Text="{x:Static l:Strings.Playtime_Loading}" Style="{StaticResource CardDescription}" Margin="4,0,0,8"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
    <TextBlock Text="{x:Static l:Strings.Playtime_Empty}" Style="{StaticResource CardDescription}" Margin="4,0,0,8"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

    <ItemsControl ItemsSource="{Binding Games}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PlaytimeGame}">
                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource NeonTrackBrush}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,48,48" RadiusX="8" RadiusY="8" />
                            </Border.Clip>
                            <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- the time, and its share of the period -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource NeonTextBrush}" />
                            <ProgressBar Value="{Binding Share, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" Margin="0,6,0,0"
                                         Foreground="{DynamicResource NeonAccentBrush}" Background="{DynamicResource NeonTrackBrush}" BorderThickness="0" />
                        </StackPanel>

                        <ui:Button Grid.Column="3" Content="{x:Static l:Strings.Playtime_Play}" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Center"
                                   Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>
</UserControl>
