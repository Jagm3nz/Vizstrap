<UserControl x:Class="Vizstrap.Views.Widgets.PlaytimeClearWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Vizstrap.Localization"
             xmlns:vm="clr-namespace:Vizstrap.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlaytimeViewModel}">
    <!-- activity widget: clearing the play time history -->
<ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Delete24}">
    <ui:CardControl.Header>
        <StackPanel>
            <TextBlock Text="{x:Static l:Strings.Playtime_Clear}" Style="{StaticResource CardTitle}" />
            <TextBlock Text="{x:Static l:Strings.Playtime_ClearDescription}" Style="{StaticResource CardDescription}" />
        </StackPanel>
    </ui:CardControl.Header>
    <ui:Button Content="{x:Static l:Strings.Playtime_Clear}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCommand}" Appearance="Danger" />
</ui:CardControl>
</UserControl>
