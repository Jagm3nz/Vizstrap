<UserControl x:Class="Vizstrap.Views.Widgets.PlaytimePeriodWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Vizstrap.Localization"
             xmlns:vm="clr-namespace:Vizstrap.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PlaytimeViewModel}">
    <!-- activity widget: today / this week / all time, and a note when activity tracking is off -->
    <UserControl.Resources>
        <!-- the period switch: pills, the chosen one in the accent colour -->
        <Style x:Key="PeriodPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NeonTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="16" Padding="16,6" Margin="0,0,8,0" BorderThickness="1"
                                Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource NeonAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NeonAccentBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource NeonAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsToday}" Content="{x:Static l:Strings.Playtime_Today}" />
            <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsThisWeek}" Content="{x:Static l:Strings.Playtime_ThisWeek}" />
            <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsAllTime}" Content="{x:Static l:Strings.Playtime_AllTime}" />
        </StackPanel>

        <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                Visibility="{Binding IsTrackingOff, Converter={StaticResource BoolToVisible}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Warning24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{x:Static l:Strings.Playtime_TrackingOff}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
