<v:NeonWindow x:Class="Vizstrap.Views.Loading.CompactLoadingWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
              Width="360"
              SizeToContent="Height"
              ResizeMode="NoResize">
    <!-- a slim bar that stays out of the way -->
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" Padding="14,12">
        <DockPanel>
            <Image DockPanel.Dock="Left" Source="{Binding IconImage}" Width="34" Height="34" Margin="0,0,12,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

            <ui:Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" ToolTip="{x:Static l:Strings.Common_Cancel}"
                       Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" BorderThickness="0" Padding="6"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToHidden}}" />

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"
                           Foreground="{DynamicResource NeonTextBrush}" />
                <ProgressBar Style="{StaticResource NeonProgressBar}" Height="4"
                             Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
            </StackPanel>
        </DockPanel>
    </Border>
</v:NeonWindow>
