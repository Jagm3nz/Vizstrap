<v:NeonWindow x:Class="Vizstrap.Views.Loading.FluentLoadingWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
              Width="500"
              Height="280"
              ResizeMode="NoResize">
    <!-- Bloxstrap's default "Bloxstrap" style: big icon, message, bar and a centred Cancel button -->
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid Margin="32,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Source="{Binding IconImage}" Width="80" Height="80" Margin="0,30,0,0"
                   HorizontalAlignment="Center" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,0,0,8" HorizontalAlignment="Center"
                       FontSize="18" TextWrapping="Wrap" Foreground="{DynamicResource NeonTextBrush}" />

            <ProgressBar Grid.Row="2" Margin="0,0,0,16" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />

            <ui:Button Grid.Row="3" Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}"
                       Width="120" HorizontalAlignment="Center" FontSize="14" />
        </Grid>
    </Border>
</v:NeonWindow>
