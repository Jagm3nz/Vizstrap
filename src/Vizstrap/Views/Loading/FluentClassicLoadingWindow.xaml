<v:NeonWindow x:Class="Vizstrap.Views.Loading.FluentClassicLoadingWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
              Width="420"
              Height="190"
              ResizeMode="NoResize">
    <!-- Bloxstrap Classic: title bar, icon beside the message, footer with Cancel -->
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="{Binding Title}" Padding="8" ShowMinimize="False" ShowMaximize="False"
                         ShowClose="False" CanMaximize="False" />

            <Grid Grid.Row="1" Margin="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="{Binding IconImage}" Width="48" Height="48" Margin="0,12,0,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Status}" Margin="16,8,0,0" FontSize="20" TextWrapping="Wrap"
                               Foreground="{DynamicResource NeonTextBrush}" />
                    <ProgressBar Margin="16,16,0,16" Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="15" Background="{DynamicResource NeonSurfaceBrush}">
                <ui:Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}"
                           Width="120" HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</v:NeonWindow>
