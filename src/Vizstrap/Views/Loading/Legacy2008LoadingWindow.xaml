<Window x:Class="Vizstrap.Views.Loading.Legacy2008LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Vizstrap.Localization"
        xmlns:vm="clr-namespace:Vizstrap.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Foreground="Black">
    <!-- Roblox's 2008–2011 dialog: Tahoma text, a bar and a Cancel button -->
    <Canvas Width="311" Height="122">
        <TextBlock Canvas.Left="12" Canvas.Top="16" Width="287" FontFamily="Tahoma" FontSize="11"
                   Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="Black" />

        <ProgressBar Style="{x:Null}" Canvas.Left="15" Canvas.Top="47" Width="281" Height="20" Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />

        <Button Style="{x:Null}" Canvas.Left="221" Canvas.Top="83" Width="75" Height="23" FontFamily="Tahoma" FontSize="11"
                Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
    </Canvas>
</Window>
