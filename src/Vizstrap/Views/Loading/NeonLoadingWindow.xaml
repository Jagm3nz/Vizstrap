<v:NeonWindow x:Class="Vizstrap.Views.Loading.NeonLoadingWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              xmlns:vm="clr-namespace:Vizstrap.ViewModels"
              mc:Ignorable="d"
              d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
              Width="380"
              SizeToContent="Height"
              ResizeMode="NoResize">

    <!-- Neon is always dark, whatever the global theme -->
    <v:NeonWindow.Resources>
        <ResourceDictionary Source="/Themes/Palette.Dark.xaml" />
    </v:NeonWindow.Resources>

    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" Padding="28,30,28,18">
        <StackPanel>
            <Image Source="{Binding IconImage}" Width="52" Height="52" Margin="0,0,0,16"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />

            <TextBlock Text="{Binding Detail, TargetNullValue=' '}" HorizontalAlignment="Center" Margin="0,4,0,14"
                       FontSize="12" Foreground="{DynamicResource NeonTextSecondaryBrush}" />

            <ProgressBar Style="{StaticResource NeonProgressBar}"
                         Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}" />

            <ui:Button Content="{x:Static l:Strings.Common_Cancel}"
                       Command="{Binding CancelCommand}"
                       Visibility="{Binding CanCancel, Converter={StaticResource BoolToHidden}}"
                       Appearance="Transparent"
                       BorderThickness="0"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0"
                       Padding="14,4"
                       FontSize="12"
                       Foreground="{DynamicResource NeonTextMutedBrush}" />
        </StackPanel>
    </Border>
</v:NeonWindow>
