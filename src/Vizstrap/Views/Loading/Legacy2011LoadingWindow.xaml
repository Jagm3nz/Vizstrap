<Window x:Class="Vizstrap.Views.Loading.Legacy2011LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:Vizstrap.Localization"
        xmlns:vm="clr-namespace:Vizstrap.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoadingViewModel}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        Foreground="Black">
    <!-- Roblox's 2011–2014 dialog: a plain Windows window; plain controls, not WPF-UI's (Style = null) -->
    <Canvas Width="362" Height="131">
        <Image Canvas.Left="19" Canvas.Top="16" Width="32" Height="32" Source="{Binding IconImage}"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <TextBlock Canvas.Left="55" Canvas.Top="23" Width="290" FontFamily="Segoe UI" FontSize="13"
                   Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="Black" />

        <ProgressBar Style="{x:Null}" Canvas.Left="58" Canvas.Top="51" Width="287" Height="26" Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />

        <Button Style="{x:Null}" Canvas.Left="271" Canvas.Top="83" Width="75" Height="23" FontFamily="Segoe UI" FontSize="12"
                Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CancelCommand}" />
    </Canvas>
</Window>
