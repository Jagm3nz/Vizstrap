<v:NeonWindow x:Class="Vizstrap.Views.InstallerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:v="clr-namespace:Vizstrap.Views"
                 xmlns:l="clr-namespace:Vizstrap.Localization"
                 xmlns:vm="clr-namespace:Vizstrap.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:InstallerViewModel}"
                 Title="Vizstrap"
                 Width="540"
                 Height="480"
                 ResizeMode="NoResize">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="Vizstrap" ShowMaximize="False" CanMaximize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- a first install's steps: start, folder, installing (the first-run wizard counts its own) -->
            <StackPanel Grid.Row="1" Margin="32,4,32,12" Visibility="{Binding ShowsSteps, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="{Binding StepText}" Style="{StaticResource CardDescription}" />
                <ProgressBar Style="{StaticResource NeonProgressBar}" Height="4" Margin="0,6,0,0" Value="{Binding StepProgress, Mode=OneWay}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="32,4,32,0">
                <!-- start: welcome and language -->
                <StackPanel Visibility="{Binding IsStartStep, Converter={StaticResource BoolToVisible}}">
                    <Image Source="{StaticResource VizstrapLogo}" Width="64" Height="64" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Static l:Strings.Installer_Welcome}" Margin="0,16,0,0"
                               FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />
                    <TextBlock Text="{x:Static l:Strings.Installer_Description}" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource NeonTextMutedBrush}" />

                    <TextBlock Text="{x:Static l:Strings.Settings_Language}" Margin="0,20,0,6" FontSize="12"
                               Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name" />
                </StackPanel>

                <!-- folder and shortcuts -->
                <StackPanel Visibility="{Binding IsFolderStep, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{x:Static l:Strings.Installer_FolderTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />
                    <TextBlock Text="{x:Static l:Strings.Installer_FolderDescription}" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource NeonTextMutedBrush}" />

                    <TextBlock Text="{x:Static l:Strings.Installer_Location}" Margin="0,20,0,6" FontSize="12"
                               Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Installer_ChangeFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding CanChangeFolder}" Margin="8,0,0,0" />
                        <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,7">
                            <TextBlock Text="{Binding InstallFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallFolder}"
                                       Foreground="{DynamicResource NeonTextBrush}" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding SpaceText}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    <TextBlock Text="{Binding FolderNote}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource NeonTextSecondaryBrush}"
                               Visibility="{Binding FolderNote, Converter={StaticResource NotNullToVisible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding FolderProblemText, Converter={StaticResource NotNullToVisible}}">
                        <ui:SymbolIcon Symbol="Warning24" Foreground="{DynamicResource NeonAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding FolderProblemText}" TextWrapping="Wrap" MaxWidth="430" Foreground="{DynamicResource NeonTextBrush}" />
                    </StackPanel>

                    <CheckBox Content="{x:Static l:Strings.Installer_DesktopShortcut}" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,18,0,0" />
                    <CheckBox Content="{x:Static l:Strings.Installer_StartMenuShortcut}" IsChecked="{Binding CreateStartMenuShortcut}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- an update over an installed Vizstrap -->
                <StackPanel Visibility="{Binding IsUpdateStep, Converter={StaticResource BoolToVisible}}">
                    <Image Source="{StaticResource VizstrapLogo}" Width="64" Height="64" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Static l:Strings.Installer_UpdateTitle}" Margin="0,16,0,0"
                               FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />
                    <TextBlock Text="{Binding UpdateInfo}" Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource NeonTextMutedBrush}" />
                    <TextBlock Text="{x:Static l:Strings.Installer_Location}" Margin="0,20,0,6" FontSize="12"
                               Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    <TextBlock Text="{Binding InstallFolder}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource NeonTextBrush}" />
                    <CheckBox Content="{x:Static l:Strings.Installer_DesktopShortcut}" IsChecked="{Binding CreateDesktopShortcut}" Margin="0,18,0,0" />
                    <CheckBox Content="{x:Static l:Strings.Installer_StartMenuShortcut}" IsChecked="{Binding CreateStartMenuShortcut}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- installing -->
                <StackPanel VerticalAlignment="Center" Visibility="{Binding IsInstallingStep, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{x:Static l:Strings.Installer_Installing}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />
                    <TextBlock Text="{Binding InstallFolder}" Margin="0,6,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    <ProgressBar Style="{StaticResource NeonProgressBar}" IsIndeterminate="True" Height="4" Margin="0,16,0,0" />
                </StackPanel>

                <!-- an update is done -->
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="56" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource NeonAccentBrush}" />
                    <TextBlock Text="{x:Static l:Strings.Installer_Done}" Margin="0,14,0,0"
                               FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource NeonTextBrush}" />
                    <TextBlock Text="{x:Static l:Strings.Installer_DoneDescription}" Margin="0,8,0,0" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource NeonTextMutedBrush}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource NeonSurfaceBrush}" Padding="32,14">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsStartStep, Converter={StaticResource BoolToVisible}}">
                        <ui:Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CloseCommand}" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
                        <ui:Button Content="{x:Static l:Strings.Welcome_Next}" Command="{Binding NextCommand}" Appearance="Primary" MinWidth="120" IsDefault="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsFolderStep, Converter={StaticResource BoolToVisible}}">
                        <ui:Button Content="{x:Static l:Strings.Welcome_Back}" Command="{Binding BackCommand}" MinWidth="96" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static l:Strings.Installer_Install}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" MinWidth="120" IsDefault="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsUpdateStep, Converter={StaticResource BoolToVisible}}">
                        <ui:Button Content="{x:Static l:Strings.Common_Cancel}" Command="{Binding CloseCommand}" MinWidth="96" Margin="0,0,8,0" IsCancel="True" />
                        <ui:Button Content="{x:Static l:Strings.Installer_Update}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                                   Appearance="Primary" MinWidth="120" IsDefault="True" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}">
                        <ui:Button Content="{x:Static l:Strings.Common_Close}" Command="{Binding CloseCommand}" MinWidth="96" Margin="0,0,8,0" />
                        <ui:Button Content="{x:Static l:Strings.Installer_LaunchRoblox}" Command="{Binding LaunchRobloxCommand}"
                                   Icon="{ui:SymbolIcon Play24}" Appearance="Primary" MinWidth="120" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</v:NeonWindow>
