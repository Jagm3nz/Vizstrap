<Page x:Class="Vizstrap.Views.SettingsPages.FastFlagEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,20,24,16" DataContext="{Binding Engine}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent" Padding="8"
                       Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{x:Static l:Strings.Page_Engine_Title}" Click="OnBack" />
            <StackPanel>
                <TextBlock Text="{x:Static l:Strings.Flags_Editor}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Static l:Strings.Flags_EditorDescription}" Style="{StaticResource PageDescription}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasIgnoredFlags, Converter={StaticResource BoolToVisible}}">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" FontSize="20" Margin="0,0,12,0" Foreground="#E0A93B" />
                <TextBlock Text="{Binding IgnoredSummary}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="True">
            <ui:Button DockPanel.Dock="Left" Content="{x:Static l:Strings.Flags_Add}" Icon="{ui:SymbolIcon Add24}"
                       Appearance="Primary" Click="OnAdd" />
            <ui:Button DockPanel.Dock="Left" Content="{x:Static l:Strings.Flags_Import}" Icon="{ui:SymbolIcon ArrowImport24}"
                       Margin="8,0,0,0" Click="OnImport" />
            <ui:Button DockPanel.Dock="Left" Content="{x:Static l:Strings.Flags_Export}" Icon="{ui:SymbolIcon DocumentCopy24}"
                       Margin="8,0,0,0" Click="OnExport" />
            <ui:Button DockPanel.Dock="Left" Content="{x:Static l:Strings.Flags_Delete}" Icon="{ui:SymbolIcon Delete24}"
                       Margin="8,0,0,0" Click="OnDelete" />
            <ui:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Static l:Strings.Flags_Search}"
                        Icon="{ui:SymbolIcon Search24}" Margin="16,0,0,0" MinWidth="160" />
        </DockPanel>

        <DataGrid x:Name="Grid" Grid.Row="3" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Extended" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static l:Strings.Flags_Name}" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="{x:Static l:Strings.Flags_Value}" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="140" />
                <DataGridTemplateColumn Header="{x:Static l:Strings.Flags_State}" Width="200" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FlagRow}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <ui:SymbolIcon x:Name="Glyph" Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0"
                                               Foreground="{DynamicResource NeonAccentBrush}" />
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                    <Setter TargetName="Glyph" Property="Symbol" Value="Warning24" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="#E0A93B" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.Flags_Empty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource CardDescription}" IsHitTestVisible="False" x:Name="EmptyText" />
    </Grid>
</Page>
