<Page x:Class="Vizstrap.Views.SettingsPages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static l:Strings.Settings_About}" Style="{StaticResource PageTitle}" Margin="0,0,24,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,8">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{StaticResource VizstrapLogo}" Width="64" Height="64"
                               VerticalAlignment="Top" Margin="0,0,18,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Vizstrap" FontSize="24" Foreground="{DynamicResource NeonTextBrush}" />
                            <TextBlock Text="{Binding VersionText}" FontSize="12" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_Credits}" Style="{StaticResource CardDescription}" Margin="0,10,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ui:CardAction Icon="{ui:SymbolIcon Link24}" Command="{Binding OpenBloxstrapCommand}" Style="{StaticResource SettingsAction}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.About_Bloxstrap}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Static l:Strings.About_BloxstrapDescription}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
