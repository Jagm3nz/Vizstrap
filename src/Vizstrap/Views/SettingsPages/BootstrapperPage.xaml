<Page x:Class="Vizstrap.Views.SettingsPages.BootstrapperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,16">
            <TextBlock Text="{x:Static l:Strings.Page_Bootstrapper_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static l:Strings.Page_Bootstrapper_Description}" Style="{StaticResource PageDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static l:Strings.Settings_RobloxVersion}" Style="{StaticResource CardTitle}" />
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding RobloxVersion}" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Reinstall}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_ReinstallDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ForceReinstall}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_BackgroundUpdates}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_BackgroundUpdatesDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding BackgroundUpdates}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_MultiInstance}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_MultiInstanceDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding MultiInstance}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}"
                                IsEnabled="{Binding MultiInstance, Converter={StaticResource InverseBool}}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_ConfirmLaunches}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_ConfirmLaunchesDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ConfirmLaunches}" />
                </ui:CardControl>

                <ui:CardAction Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenRobloxFolderCommand}" Style="{StaticResource SettingsAction}">
                    <StackPanel>
                        <TextBlock Text="{x:Static l:Strings.Settings_OpenRobloxFolder}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Static l:Strings.Settings_OpenRobloxFolderDescription}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </ui:CardAction>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
