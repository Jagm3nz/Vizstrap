<Page x:Class="Vizstrap.Views.SettingsPages.IntegrationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <!-- mirrors Bloxstrap's "Integrations": activity tracking, Discord Rich Presence, custom integrations -->
    <Grid Margin="24,20,0,0" DataContext="{Binding Integrations}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,16">
            <TextBlock Text="{x:Static l:Strings.Page_Integrations_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static l:Strings.Page_Integrations_Description}" Style="{StaticResource PageDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <TextBlock Text="{x:Static l:Strings.Integrations_ActivityTracking}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon DocumentSearch24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_EnableTracking}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_EnableTrackingDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding EnableActivityTracking}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Globe24}"
                                IsEnabled="{Binding EnableActivityTracking}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_ServerLocation}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_ServerLocationDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowServerLocation}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon DoorArrowLeft24}"
                                IsEnabled="{Binding EnableActivityTracking}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_DesktopApp}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_DesktopAppDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding DisableDesktopApp}" />
                </ui:CardControl>

                <TextBlock Text="Discord Rich Presence" Style="{StaticResource SectionTitle}" Margin="0,16,0,2" />
                <TextBlock Text="{x:Static l:Strings.Integrations_DiscordNote}" Style="{StaticResource CardDescription}" Margin="0,0,0,8" />

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Games24}"
                                IsEnabled="{Binding EnableActivityTracking}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_ShowActivity}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_ShowActivityDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding UseDiscordRichPresence}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PeopleAdd24}"
                                IsEnabled="{Binding UseDiscordRichPresence}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_AllowJoining}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_AllowJoiningDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding AllowActivityJoining}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PersonCircle24}"
                                IsEnabled="{Binding UseDiscordRichPresence}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_ShowAccount}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_ShowAccountDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowAccountOnProfile}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Sparkle24}"
                                IsEnabled="{Binding UseDiscordRichPresence}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_Watermark}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_WatermarkDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowVizstrapWatermark}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Home24}"
                                IsEnabled="{Binding UseDiscordRichPresence}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Integrations_InMenu}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Integrations_InMenuDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding ShowPresenceInMenu}" />
                </ui:CardControl>

                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8"
                        IsEnabled="{Binding UseDiscordRichPresence}">
                    <StackPanel>
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Image24" FontSize="22" Margin="0,2,14,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource NeonAccentBrush}" />
                            <StackPanel>
                                <TextBlock Text="{x:Static l:Strings.Integrations_OwnApp}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static l:Strings.Integrations_OwnAppDescription}" Style="{StaticResource CardDescription}" />
                                <TextBlock Text="{x:Static l:Strings.Integrations_OwnAppSteps}" Style="{StaticResource CardDescription}" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="36,12,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Integrations_OpenPortal}"
                                       Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenDeveloperPortalCommand}" Margin="8,0,0,0" />
                            <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Integrations_PrepareLogos}"
                                       Icon="{ui:SymbolIcon ImageMultiple24}" Command="{Binding PrepareDiscordLogosCommand}" Margin="8,0,0,0" />
                            <ui:TextBox Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="{x:Static l:Strings.Integrations_AppIdPlaceholder}" />
                        </DockPanel>

                        <TextBlock Text="{x:Static l:Strings.Integrations_AppIdInvalid}" Foreground="#E5484D" Margin="36,6,0,0"
                                   Visibility="{Binding IsDiscordApplicationIdValid, Converter={StaticResource InverseBoolToVisible}}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static l:Strings.Integrations_Custom}" Style="{StaticResource SectionTitle}" Margin="0,16,0,2" />
                <TextBlock Text="{x:Static l:Strings.Integrations_CustomDescription}" Style="{StaticResource CardDescription}" Margin="0,0,0,8" />

                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration}"
                                 DisplayMemberPath="Name" Margin="0,0,8,0" />

                        <Grid Grid.Row="1" Margin="0,8,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="{x:Static l:Strings.Integrations_New}" Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding AddIntegrationCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                            <ui:Button Grid.Column="1" Content="{x:Static l:Strings.Integrations_Delete}" Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DeleteIntegrationCommand}" Appearance="Danger"
                                       HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                        </Grid>

                        <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="8,0,0,0"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{x:Static l:Strings.Integrations_Name}" Style="{StaticResource CardDescription}" />
                            <ui:TextBox Text="{Binding SelectedIntegration.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" />

                            <TextBlock Text="{x:Static l:Strings.Integrations_Location}" Style="{StaticResource CardDescription}" Margin="0,10,0,0" />
                            <DockPanel Margin="0,4,0,0">
                                <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Integrations_Browse}"
                                           Icon="{ui:SymbolIcon Folder24}" Command="{Binding BrowseLocationCommand}"
                                           Margin="8,0,0,0" VerticalAlignment="Stretch" />
                                <ui:TextBox Text="{Binding SelectedIntegration.Location, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="C:\Program Files\OBS Studio\bin\64bit\obs64.exe" />
                            </DockPanel>

                            <TextBlock Text="{x:Static l:Strings.Integrations_LaunchArgs}" Style="{StaticResource CardDescription}" Margin="0,10,0,0" />
                            <ui:TextBox Text="{Binding SelectedIntegration.LaunchArgs, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,4,0,0"
                                        PlaceholderText="--startrecording --minimize-to-tray" />

                            <CheckBox Content="{x:Static l:Strings.Integrations_AutoClose}"
                                      IsChecked="{Binding SelectedIntegration.AutoClose}" Margin="0,10,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{x:Static l:Strings.Integrations_NoneSelected}"
                                   Style="{StaticResource CardDescription}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisible}}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
