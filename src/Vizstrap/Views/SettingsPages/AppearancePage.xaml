<Page x:Class="Vizstrap.Views.SettingsPages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <!-- mirrors Bloxstrap's Appearance page: theme, language, then the loading window ("Bootstrapper") -->
    <Grid Margin="24,20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,16">
            <TextBlock Text="{x:Static l:Strings.Page_Appearance_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static l:Strings.Page_Appearance_Description}" Style="{StaticResource PageDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <TextBlock Text="{x:Static l:Strings.Settings_Theme}" Style="{StaticResource CardTitle}" />
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="Name" Width="220" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Accent}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_AccentDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Accents}" SelectedItem="{Binding SelectedAccent}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon PaintBucket24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_RobloxTheme}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_RobloxThemeDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding RobloxAccentTheme}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Language}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_LanguageDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name" Width="220" />
                </ui:CardControl>

                <DockPanel Margin="0,16,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Settings_Preview}" Icon="{ui:SymbolIcon Eye24}"
                               VerticalAlignment="Center" MinWidth="110" Click="OnPreview" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{x:Static l:Strings.Settings_LoadingWindow}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{x:Static l:Strings.Settings_LoadingWindowDescription}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                </DockPanel>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Style}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_StyleDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                              DisplayMemberPath="Name" Width="220" />
                </ui:CardControl>

                <!-- the "Custom" style's editor -->
                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8"
                        Visibility="{Binding IsCustomStyle, Converter={StaticResource BoolToVisible}}">
                    <Grid DataContext="{Binding LoadingThemes}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static l:Strings.Theme_Editor}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Theme_EditorDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="{x:Static l:Strings.Theme_Background}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Border Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                                    Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                            <ui:TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.Theme_Picture}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <ui:Button Content="{x:Static l:Strings.Theme_ChoosePicture}" Icon="{ui:SymbolIcon Image24}" Command="{Binding ChooseBackgroundCommand}" />
                            <ui:Button Content="{x:Static l:Strings.Theme_RemovePicture}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveBackgroundCommand}"
                                       Margin="8,0,0,0" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisible}}" />
                            <CheckBox Content="{x:Static l:Strings.Theme_Fill}" IsChecked="{Binding FillImage}" Margin="12,0,0,0"
                                      Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="{x:Static l:Strings.Theme_Dim}" Style="{StaticResource CardDescription}" VerticalAlignment="Center"
                                   Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisible}}" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4" Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisible}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Dim, StringFormat={}{0} %}" Width="44" TextAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                            <Slider Minimum="0" Maximum="80" Value="{Binding Dim}" IsSnapToTickEnabled="True" TickFrequency="5" MaxWidth="320"
                                    HorizontalAlignment="Left" Width="260" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Grid.Row="4" Text="{x:Static l:Strings.Theme_TextColor}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Border Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                                    Background="{Binding TextColor, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0" />
                            <ui:TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Width="130" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="{x:Static l:Strings.Theme_BarColor}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <CheckBox Content="{x:Static l:Strings.Theme_BarAccent}" IsChecked="{Binding BarUsesAccent}" Margin="0,0,12,0" />
                            <Border Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                                    Background="{Binding BarColor, Converter={StaticResource HexToBrush}}" Margin="0,0,8,0"
                                    Visibility="{Binding BarUsesAccent, Converter={StaticResource InverseBoolToVisible}}" />
                            <ui:TextBox Text="{Binding BarColor, UpdateSourceTrigger=PropertyChanged}" Width="130"
                                        Visibility="{Binding BarUsesAccent, Converter={StaticResource InverseBoolToVisible}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Text="{x:Static l:Strings.Theme_Layout}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                                  DisplayMemberPath="Name" Width="220" HorizontalAlignment="Left" Margin="0,4" />

                        <TextBlock Grid.Row="7" Text="{x:Static l:Strings.Theme_Size}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}"
                                  DisplayMemberPath="Name" Width="220" HorizontalAlignment="Left" Margin="0,4" />

                        <TextBlock Grid.Row="8" Text="{x:Static l:Strings.Theme_ShowIcon}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Row="8" Grid.Column="1" IsChecked="{Binding ShowIcon}" Margin="0,4" />

                        <DockPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Theme_Reset}" Icon="{ui:SymbolIcon ArrowReset24}"
                                       Command="{Binding ResetCustomThemeCommand}" />
                            <TextBlock Text="{x:Static l:Strings.Theme_InvalidColor}" Foreground="#E5484D" VerticalAlignment="Center" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBackgroundColorValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTextColorValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBarColorValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- themes in Bloxstrap's XML format -->
                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8"
                        Visibility="{Binding IsXmlThemeStyle, Converter={StaticResource BoolToVisible}}">
                    <Grid DataContext="{Binding LoadingThemes}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <ui:HyperlinkButton DockPanel.Dock="Right" Content="{x:Static l:Strings.XmlThemes_Examples}"
                                                Command="{Binding OpenXmlThemeExamplesCommand}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{x:Static l:Strings.XmlThemes_Title}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static l:Strings.XmlThemes_Description}" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1" MinHeight="180" Margin="0,0,12,0">
                            <ListBox ItemsSource="{Binding XmlThemeOptions}" SelectedItem="{Binding SelectedXmlTheme}" DisplayMemberPath="Name" />
                        </Grid>

                        <StackPanel Grid.Row="1" Grid.Column="1" MinWidth="170">
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_New}" Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding NewXmlThemeCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_ImportZip}" Icon="{ui:SymbolIcon FolderZip24}"
                                       Command="{Binding ImportZipCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_ImportBloxstrap}" Icon="{ui:SymbolIcon ArrowImport24}"
                                       Command="{Binding ImportFromBloxstrapCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                       Visibility="{Binding CanImportFromBloxstrap, Converter={StaticResource BoolToVisible}}" />
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_Edit}" Icon="{ui:SymbolIcon Edit24}"
                                       Command="{Binding EditXmlThemeCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                                       Command="{Binding OpenXmlThemesFolderCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <ui:Button Content="{x:Static l:Strings.XmlThemes_Delete}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger"
                                       Command="{Binding DeleteXmlThemeCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ui:CardControl Style="{StaticResource SettingsCard}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Icon}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_IconDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding SelectedIcon}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IconOption}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="20" Height="20" Margin="0,0,10,0">
                                        <Image Source="{Binding Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </ui:CardControl>

                <ui:CardExpander Margin="0,0,0,8" ContentPadding="16">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Settings_Customization}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Settings_CustomizationDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Static l:Strings.Settings_LoadingTitle}" Style="{StaticResource CardTitle}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <ui:TextBox Grid.Column="1" Text="{Binding LoadingTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static l:Strings.Settings_LoadingTitleDescription}"
                                   Style="{StaticResource CardDescription}" Margin="0,4,0,16" />

                        <TextBlock Grid.Row="2" Text="{x:Static l:Strings.Settings_CustomIcon}" Style="{StaticResource CardTitle}"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <DockPanel Grid.Row="2" Grid.Column="1">
                            <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Settings_Browse}"
                                       Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding BrowseIconCommand}" Margin="8,0,0,0" />
                            <ui:TextBox Text="{Binding CustomIconPath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static l:Strings.Settings_CustomIconDescription}"
                                   Style="{StaticResource CardDescription}" Margin="0,4,0,0" />
                    </Grid>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
