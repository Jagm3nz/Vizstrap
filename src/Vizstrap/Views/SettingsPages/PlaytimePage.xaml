<Page x:Class="Vizstrap.Views.SettingsPages.PlaytimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False"
      Loaded="OnLoaded">
    <Page.Resources>
        <!-- the period switch: pills, the chosen one in the accent colour -->
        <Style x:Key="PeriodPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource NeonTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="16" Padding="16,6" Margin="0,0,8,0" BorderThickness="1"
                                Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource NeonAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource NeonAccentBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource NeonAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource NeonTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Page.Resources>

    <!-- how long each game was played: today, this week, in all (Activity.PlaytimeStore) -->
    <Grid Margin="24,20,0,0" DataContext="{Binding Playtime}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,16">
            <TextBlock Text="{x:Static l:Strings.Page_Playtime_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static l:Strings.Page_Playtime_Description}" Style="{StaticResource PageDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <DockPanel Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" Content="{x:Static l:Strings.Playtime_Clear}" Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ClearCommand}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsToday}" Content="{x:Static l:Strings.Playtime_Today}" />
                        <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsThisWeek}" Content="{x:Static l:Strings.Playtime_ThisWeek}" />
                        <RadioButton Style="{StaticResource PeriodPill}" GroupName="PlaytimePeriod" IsChecked="{Binding IsAllTime}" Content="{x:Static l:Strings.Playtime_AllTime}" />
                    </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                        Visibility="{Binding IsTrackingOff, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Warning24" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static l:Strings.Playtime_TrackingOff}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- the period's sums -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Playtime_Total}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{Binding TotalText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Playtime_Sessions}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{Binding SessionsText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Playtime_TopGame}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{Binding TopGameText}" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- the last 7 days, one bar a day; the busiest day fills the chart -->
                <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChartMaxText}" Style="{StaticResource CardDescription}" />
                            <TextBlock Text="{x:Static l:Strings.Playtime_LastDays}" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <Grid Margin="0,10,0,0">
                            <!-- the busiest day's line and the baseline, faint -->
                            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource NeonBorderBrush}" Margin="0,0,0,0" />
                            <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource NeonBorderBrush}" Margin="0,120,0,0" />
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlaytimeDay}">
                                        <StackPanel Background="Transparent" ToolTip="{Binding Tooltip}">
                                            <Grid Height="120">
                                                <Border Width="28" Height="{Binding BarHeight}" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                        Background="{DynamicResource NeonAccentBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="DayLabel" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource NeonTextBrush}" />
                                                <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static l:Strings.Playtime_Games}" Style="{StaticResource SectionTitle}" Margin="0,8,0,10" />

                <TextBlock Text="{x:Static l:Strings.Playtime_Loading}" Style="{StaticResource CardDescription}" Margin="4,0,0,8"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Text="{x:Static l:Strings.Playtime_Empty}" Style="{StaticResource CardDescription}" Margin="4,0,0,8"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlaytimeGame}">
                            <Border Background="{DynamicResource NeonSurfaceBrush}" BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="48" Height="48" CornerRadius="8" Margin="0,0,12,0" Background="{DynamicResource NeonTrackBrush}">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,48,48" RadiusX="8" RadiusY="8" />
                                        </Border.Clip>
                                        <Image Source="{Binding IconUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource CardDescription}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- the time, and its share of the period -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Time}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource NeonTextBrush}" />
                                        <ProgressBar Value="{Binding Share, Mode=OneWay}" Minimum="0" Maximum="1" Height="4" Margin="0,6,0,0"
                                                     Foreground="{DynamicResource NeonAccentBrush}" Background="{DynamicResource NeonTrackBrush}" BorderThickness="0" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="3" Content="{x:Static l:Strings.Playtime_Play}" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Center"
                                               Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
