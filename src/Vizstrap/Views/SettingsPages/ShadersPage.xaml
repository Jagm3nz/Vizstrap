<Page x:Class="Vizstrap.Views.SettingsPages.ShadersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Vizstrap.Localization"
      xmlns:vm="clr-namespace:Vizstrap.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      ScrollViewer.CanContentScroll="False">
    <!-- picture effects ("shaders"): an overlay with approximate ray tracing (Vizstrap.Effects) and packages' HLSL effects -->
    <Grid Margin="24,20,0,0" DataContext="{Binding Effects}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,24,16">
            <TextBlock Text="{x:Static l:Strings.Page_Shaders_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{x:Static l:Strings.Page_Shaders_Description}" Style="{StaticResource PageDescription}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,24,16">
                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Lightbulb24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Effects_Enable}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Effects_EnableDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" IsEnabled="{Binding Enabled}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Effects_Preset}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="220" />
                </ui:CardControl>

                <ui:CardControl Style="{StaticResource SettingsCard}" Icon="{ui:SymbolIcon Image24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Effects_Preview}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding PreviewText}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button Content="{x:Static l:Strings.Effects_PreviewOpen}" Icon="{ui:SymbolIcon Eye24}"
                               Command="{Binding OpenPreviewCommand}" IsEnabled="{Binding HasPreview}" MinWidth="110" />
                </ui:CardControl>

                <ui:CardExpander Margin="0,0,0,8" IsEnabled="{Binding Enabled}" Icon="{ui:SymbolIcon Options24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Effects_Adjust}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Effects_CaptureNote}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel Margin="8,4,8,8">
                        <DockPanel Margin="0,0,0,8">
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseDepth}" VerticalAlignment="Center" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{x:Static l:Strings.Effects_UseDepth}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{x:Static l:Strings.Effects_UseDepthDescription}" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel IsEnabled="{Binding UseDepth}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_AmbientOcclusion}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding AmbientOcclusion}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AmbientOcclusion}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_IndirectLight}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding IndirectLight}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding IndirectLight}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Haze}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Haze}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Haze}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_DepthOfField}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DepthOfField}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding DepthOfField}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Reflections}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Reflections}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Reflections}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_SunRays}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding SunRays}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding SunRays}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        </StackPanel>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Bloom}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Bloom}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Bloom}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Contrast}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Contrast}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Contrast}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Saturation}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding Saturation}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Saturation}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Warmth}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding Warmth}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Warmth}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Vignette}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Vignette}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Vignette}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static l:Strings.Effects_Sharpen}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Sharpen}" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Sharpen}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- effects from switched-on packages, each with the sliders its name.json describes -->
                <ui:CardExpander Margin="0,0,0,8" IsEnabled="{Binding Enabled}" IsExpanded="True" Icon="{ui:SymbolIcon PuzzlePiece24}"
                                 Visibility="{Binding HasCustomEffects, Converter={StaticResource BoolToVisible}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="{x:Static l:Strings.Effects_FromPackages}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{x:Static l:Strings.Effects_FromPackagesDescription}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <ItemsControl ItemsSource="{Binding CustomEffects}" Margin="8,4,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CustomEffectItem}">
                                <StackPanel Margin="0,4,0,8">
                                    <DockPanel>
                                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding ErrorText, Converter={StaticResource NotNullToVisible}}" />
                                    <ItemsControl ItemsSource="{Binding Parameters}" IsEnabled="{Binding Enabled}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CustomParameterItem}">
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="44" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                                            SmallChange="{Binding Step}" LargeChange="{Binding Step}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
