<v:NeonWindow x:Class="Vizstrap.Views.EffectsPreviewWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
              xmlns:v="clr-namespace:Vizstrap.Views"
              xmlns:l="clr-namespace:Vizstrap.Localization"
              Title="{x:Static l:Strings.Effects_PreviewTitle}"
              Width="1000"
              Height="660"
              MinWidth="640"
              MinHeight="420">
    <Border BorderBrush="{DynamicResource NeonBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Title="{x:Static l:Strings.Effects_PreviewTitle}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource VizstrapLogo}" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Viewbox Grid.Row="1" Margin="16,4,16,8" Stretch="Uniform">
                <Grid x:Name="Pictures">
                    <Image x:Name="Before" Stretch="None" />
                    <Image x:Name="After" Stretch="None" />
                    <Rectangle x:Name="Divider" Width="2" Fill="White" HorizontalAlignment="Left" Opacity="0.85" />

                    <Border Background="#B0120F26" CornerRadius="6" Padding="10,4" Margin="12"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock Text="{x:Static l:Strings.Effects_Before}" Foreground="White" FontSize="16" />
                    </Border>
                    <Border Background="#B0120F26" CornerRadius="6" Padding="10,4" Margin="12"
                            HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="{x:Static l:Strings.Effects_After}" Foreground="White" FontSize="16" />
                    </Border>
                </Grid>
            </Viewbox>

            <StackPanel Grid.Row="2" Margin="24,0,24,16">
                <Slider x:Name="Split" Minimum="0" Maximum="1" Value="0.5" ValueChanged="OnSplitChanged" />
                <TextBlock Text="{x:Static l:Strings.Effects_PreviewHint}" Style="{StaticResource CardDescription}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</v:NeonWindow>
