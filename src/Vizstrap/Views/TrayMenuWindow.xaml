<Window x:Class="Vizstrap.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Vizstrap.Localization"
        Title="Vizstrap"
        Width="0"
        Height="0"
        Left="-100"
        Top="-100"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">
    <!-- invisible host of the tray icon's menu (Bloxstrap's MenuContainer); items appear as the game allows -->
    <Window.ContextMenu>
        <ContextMenu x:Name="Menu">
            <MenuItem IsEnabled="False">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource VizstrapLogo}" Width="18" Height="18" />
                        <TextBlock x:Name="VersionText" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource NeonTextSecondaryBrush}" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator />
            <MenuItem x:Name="RichPresenceItem" Header="Discord Rich Presence" IsCheckable="True" IsChecked="True"
                      Visibility="Collapsed" Click="OnRichPresenceClick" />
            <MenuItem x:Name="CopyInviteItem" Header="{x:Static l:Strings.Tray_CopyInvite}" Visibility="Collapsed"
                      Icon="{ui:SymbolIcon ClipboardLink24}" Click="OnCopyInviteClick" />
            <MenuItem x:Name="ServerInfoItem" Header="{x:Static l:Strings.Tray_ServerInfo}" Visibility="Collapsed"
                      Icon="{ui:SymbolIcon Info24}" Click="OnServerInfoClick" />
            <MenuItem x:Name="GameHistoryItem" Header="{x:Static l:Strings.Tray_GameHistory}" Visibility="Collapsed"
                      Icon="{ui:SymbolIcon History24}" Click="OnGameHistoryClick" />
            <MenuItem Header="{x:Static l:Strings.Tray_CloseRoblox}"
                      Icon="{ui:SymbolIcon WindowHeaderHorizontalOff20}" Click="OnCloseRobloxClick" />
            <MenuItem x:Name="OpenLogItem" Header="{x:Static l:Strings.Tray_OpenLog}" Visibility="Collapsed"
                      Icon="{ui:SymbolIcon DocumentCatchUp20}" Click="OnOpenLogClick" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
