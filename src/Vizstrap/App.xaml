<Application x:Class="Vizstrap.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Vizstrap"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="Themes/Neon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToHiddenConverter x:Key="BoolToHidden" />
            <local:InverseBoolToVisibleConverter x:Key="InverseBoolToVisible" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:NotNullToVisibleConverter x:Key="NotNullToVisible" />
            <BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <local:HexToBrushConverter x:Key="HexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
