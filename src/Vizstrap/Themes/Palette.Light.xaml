<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neon, light: lavender surfaces with the same violet accent, darkened for contrast -->
    <Color x:Key="NeonBackgroundColor">#F4F2FC</Color>

    <SolidColorBrush x:Key="NeonBackgroundBrush" Color="#F4F2FC" />
    <SolidColorBrush x:Key="NeonSurfaceBrush" Color="#E9E6F8" />
    <SolidColorBrush x:Key="NeonBorderBrush" Color="#CFC9F0" />
    <SolidColorBrush x:Key="NeonTrackBrush" Color="#E0DCF6" />
    <SolidColorBrush x:Key="NeonAccentBrush" Color="#5A51C8" />
    <SolidColorBrush x:Key="NeonTextBrush" Color="#1A1730" />
    <SolidColorBrush x:Key="NeonTextSecondaryBrush" Color="#5A51C8" />
    <SolidColorBrush x:Key="NeonTextMutedBrush" Color="#3F3A5E" />

</ResourceDictionary>
